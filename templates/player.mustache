{{!
    @template mod_videosummary/player

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videosummary-player" data-region="videosummary-player" data-config="{{configjson}}">
    <div class="videosummary-player__media">
        {{{sourcehtml}}}
    </div>
    <div class="videosummary-progress mt-3">
        <div class="d-flex justify-content-between">
            <strong>{{#str}}progress, videosummary{{/str}}</strong>
            <span data-region="percent">{{progressrounded}}%</span>
        </div>
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="{{progressrounded}}">
            <div class="progress-bar" data-region="progress-bar" style="width: {{progressrounded}}%"></div>
        </div>
        <div class="small text-muted mt-1">{{#str}}lastposition, videosummary{{/str}}: {{lastpositionformatted}}</div>
        <div class="videosummary-timeline mt-2" aria-label="{{#str}}timeline, videosummary{{/str}}">
            <div class="videosummary-timeline__track" data-region="timeline-track">
                {{#timeline}}
                    <button type="button" class="videosummary-timeline__watched"
                            style="left: {{left}}%; width: {{width}}%;"
                            title="{{tooltip}}" data-videosummary-seek="{{start}}"
                            aria-label="{{tooltip}}"></button>
                {{/timeline}}
            </div>
            <div class="small text-muted mt-1">{{#str}}timelinehint, videosummary{{/str}}</div>
        </div>
    </div>
    <div class="alert alert-warning d-none mt-2" data-region="tracking-message" role="status"></div>
</div>
