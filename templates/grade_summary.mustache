{{!
    @template mod_videosummary/grade_summary

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videosummary-grade-summary card mb-4">
    <div class="card-body">
        <h3 class="h4">{{fullname}}</h3>
        <div class="videosummary-text mt-3">{{{summaryhtml}}}</div>
        {{#hasreferences}}
            <h4 class="h5 mt-4">{{#str}}references, videosummary{{/str}}</h4>
            <div class="list-group">
                {{#references}}
                    <div class="list-group-item"><strong>{{range}}</strong>{{#label}} — {{label}}{{/label}}{{#note}}
                        <div>{{note}}</div>{{/note}}</div>
                {{/references}}
            </div>
        {{/hasreferences}}
    </div>
</div>
