{{!
    @template mod_videosummary/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videosummary-report">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>{{#str}}student, videosummary{{/str}}</th>
                <th>{{#str}}percentwatched, videosummary{{/str}}</th>
                <th>{{#str}}summarystarted, videosummary{{/str}}</th>
                <th>{{#str}}summarydelivered, videosummary{{/str}}</th>
                <th>{{#str}}referencescount, videosummary{{/str}}</th>
                <th>{{#str}}grade, videosummary{{/str}}</th>
                <th>{{#str}}status, videosummary{{/str}}</th>
                <th>{{#str}}actions, videosummary{{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{#rows}}
                <tr>
                    <td><a href="{{{profileurl}}}">{{fullname}}</a></td>
                    <td>{{percent}}%</td>
                    <td>{{started}}</td>
                    <td>{{delivered}}</td>
                    <td>{{references}}</td>
                    <td>{{grade}}</td>
                    <td>{{status}}</td>
                    <td>{{#hasgradeurl}}<a class="btn btn-sm btn-outline-primary" href="{{{gradeurl}}}">{{#str}}
                        gradeaction, videosummary{{/str}}</a>{{/hasgradeurl}}</td>
                </tr>
            {{/rows}}
            </tbody>
        </table>
    </div>
</div>
